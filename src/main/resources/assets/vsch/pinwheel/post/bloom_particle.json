{
  "stages": [
    {
      "type": "veil:mask",
      "depth": true
    },
    {
      "type": "veil:blit",
      "shader": "vsch:core/blit_cull",
      "in": "vsch:bloom_particle",
      "out": "swap",
      "clear": true
    },
    {
      "type": "veil:copy",
      "in": "swap",
      "out": "vsch:bloom_particle"
    },
    {
      "type": "veil:blit",
      "shader": "vsch:blur/blur_horizontal",
      "in": "swap",
      "out": "layer1",
      "clear": true
    },
    {
      "type": "veil:blit",
      "shader": "vsch:blur/blur_vertical",
      "in": "layer1",
      "out": "swap",
      "clear": true
    },
    {
      "type": "veil:blit",
      "shader": "vsch:blur/blur_horizontal",
      "in": "swap",
      "out": "layer2",
      "clear": true
    },
    {
      "type": "veil:blit",
      "shader": "vsch:blur/blur_vertical",
      "in": "layer2",
      "out": "swap",
      "clear": true
    },
    {
      "type": "veil:blit",
      "shader": "vsch:blur/blur_horizontal",
      "in": "swap",
      "out": "layer3",
      "clear": true
    },
    {
      "type": "veil:blit",
      "shader": "vsch:blur/blur_vertical",
      "in": "layer3",
      "out": "swap",
      "clear": true
    },
    {
      "type": "veil:blit",
      "shader": "vsch:blur/blur_horizontal",
      "in": "swap",
      "out": "layer1",
      "clear": true
    },
    {
      "type": "veil:blit",
      "shader": "vsch:blur/blur_vertical",
      "in": "layer1",
      "out": "final",
      "clear": true
    },
    {
      "type": "veil:mask",
      "depth": false
    },
    {
      "type": "veil:blit",
      "shader": "vsch:bloom/bloom_particle",
      "in": "minecraft:main",
      "out": "swap",
      "clear": true
    },
    {
      "type": "veil:copy",
      "in": "swap",
      "out": "veil:post"
    }
  ],
  "framebuffers": {
    "swap": {
      "depth": true,
      "format": "RGBA16F",
      "linear": true,
      "autoClear": true
    },
    "final": {
      "depth": false,
      "format": "RGBA16F",
      "linear": true,
      "autoClear": true
    },
    "layer1": {
      "width": "q.screen_width / 1.0",
      "height": "q.screen_height / 1.0",
      "depth": false,
      "format": "RGBA16",
      "linear": true,
      "autoClear": true
    },
    "layer2": {
      "width": "q.screen_width / 2.0",
      "height": "q.screen_height / 2.0",
      "depth": false,
      "format": "RGBA16",
      "linear": true,
      "autoClear": true
    },
    "layer3": {
      "width": "q.screen_width / 4.0",
      "height": "q.screen_height / 4.0",
      "depth": false,
      "format": "RGBA16",
      "linear": true,
      "autoClear": true
    }
  },
  "textures": {
    "BlurSampler": {
      "type": "framebuffer",
      "name": "final"
    }
  }
}